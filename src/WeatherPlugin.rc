#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

IDD_OPTIONS_DIALOG DIALOGEX 0, 0, 360, 372
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WeatherPlus Options"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_PREVIEW_BOX,"Static",SS_OWNERDRAW | SS_NOTIFY | WS_BORDER,10,6,276,32
    PUSHBUTTON      "Dark / Light",IDC_BTN_PREVIEW_THEME,290,14,60,16

    LTEXT           "Language:",IDC_LBL_LANG,10,45,98,10
    COMBOBOX        IDC_COMBO_LANG,112,43,238,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Provider:",IDC_LBL_PROVIDER,10,63,98,10
    COMBOBOX        IDC_COMBO_PROVIDER,112,61,238,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Yandex Key:",IDC_LBL_API_KEY,10,81,98,10
    EDITTEXT        IDC_EDIT_API_KEY,112,79,238,14,ES_AUTOHSCROLL

    LTEXT           "City / Coords:",IDC_LBL_LOCATION,10,99,98,10
    EDITTEXT        IDC_EDIT_QUERY,112,97,178,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Find",IDC_BTN_SEARCH,296,97,54,14

    EDITTEXT        IDC_EDIT_COUNTRY,112,115,238,14,ES_AUTOHSCROLL

    LTEXT           "Matched:",IDC_LBL_RESULTS,10,137,98,10
    COMBOBOX        IDC_COMBO_RESULTS,112,135,238,90,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Display City:",IDC_LBL_CUSTOM_CITY,10,155,98,10
    EDITTEXT        IDC_EDIT_CUSTOM_CITY,112,153,238,14,ES_AUTOHSCROLL

    LTEXT           "Units / Mode:",IDC_LBL_UNITS,10,175,98,10
    COMBOBOX        IDC_COMBO_UNITS,112,173,88,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_COMBO_MODE,206,173,144,70,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Slots / Scroll:",IDC_LBL_EXT_SLOTS,10,193,98,10
    COMBOBOX        IDC_COMBO_EXT_SLOTS,112,191,114,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_COMBO_SCROLL,232,191,118,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Style:",IDC_LBL_ICON_STYLE,10,211,98,10
    COMBOBOX        IDC_COMBO_ICON_STYLE,112,209,238,110,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Vignette:",IDC_LBL_VIGNETTE,10,229,98,10
    COMBOBOX        IDC_COMBO_VIGNETTE,112,227,238,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Bars (Size / Color):",IDC_LBL_BAR_OPT,10,247,98,10
    COMBOBOX        IDC_COMBO_BAR_THICK,112,245,110,70,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_COMBO_BAR_CONTRAST,228,245,122,70,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Border & Bg:",IDC_LBL_BORDER,10,265,98,10
    COMBOBOX        IDC_COMBO_BORDER,112,263,238,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Temp Alert:",IDC_LBL_ALERT,10,283,98,10
    COMBOBOX        IDC_COMBO_ALERT,112,281,108,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_EDIT_ALERT_DAYS,224,281,30,14,ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "d.",IDC_LBL_ALERT_DAYS,257,283,22,10
    EDITTEXT        IDC_EDIT_ALERT_DIFF,282,281,34,14,ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "deg",IDC_LBL_ALERT_DEG,319,283,30,10

    LTEXT           "Alert Position:",IDC_LBL_ALERT_POS,10,303,98,10
    COMBOBOX        IDC_COMBO_ALERT_POS,112,301,238,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    CONTROL         "Fill with tomorrow slots",IDC_CHK_FILL_TOMORROW,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,112,320,238,11

    LTEXT           "Refresh (min):",IDC_LBL_REFRESH,10,336,98,10
    EDITTEXT        IDC_EDIT_REFRESH,112,334,52,14,ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "",IDC_LBL_STATUS,170,336,180,10

    DEFPUSHBUTTON   "OK",IDOK,232,353,56,14
    PUSHBUTTON      "Cancel",IDCANCEL,294,353,56,14
END
