#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

IDD_OPTIONS_DIALOG DIALOGEX 0, 0, 324, 306
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WeatherPlus Options"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Language:",IDC_LBL_LANG,12,12,86,10
    COMBOBOX        IDC_COMBO_LANG,104,10,208,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Provider:",IDC_LBL_PROVIDER,12,30,86,10
    COMBOBOX        IDC_COMBO_PROVIDER,104,28,208,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Yandex Key:",IDC_LBL_API_KEY,12,48,86,10
    EDITTEXT        IDC_EDIT_API_KEY,104,46,208,14,ES_AUTOHSCROLL

    LTEXT           "Location:",IDC_LBL_LOCATION,12,70,86,10
    EDITTEXT        IDC_EDIT_QUERY,104,68,148,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Find",IDC_BTN_SEARCH,258,68,54,14

    EDITTEXT        IDC_EDIT_COUNTRY,104,86,208,14,ES_AUTOHSCROLL

    LTEXT           "Matched:",IDC_LBL_RESULTS,12,106,86,10
    COMBOBOX        IDC_COMBO_RESULTS,104,104,208,90,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Display City:",IDC_LBL_CUSTOM_CITY,12,124,86,10
    EDITTEXT        IDC_EDIT_CUSTOM_CITY,104,122,208,14,ES_AUTOHSCROLL

    LTEXT           "Units:",IDC_LBL_UNITS,12,148,86,10
    COMBOBOX        IDC_COMBO_UNITS,104,146,208,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Mode:",IDC_LBL_MODE,12,166,86,10
    COMBOBOX        IDC_COMBO_MODE,104,164,208,70,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Extended Slots:",IDC_LBL_EXT_SLOTS,12,184,86,10
    COMBOBOX        IDC_COMBO_EXT_SLOTS,104,182,208,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Scroll Mode:",IDC_LBL_SCROLL,12,202,86,10
    COMBOBOX        IDC_COMBO_SCROLL,104,200,208,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Icon Style:",IDC_LBL_ICON_STYLE,12,220,86,10
    COMBOBOX        IDC_COMBO_ICON_STYLE,104,218,208,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Block Border:",IDC_LBL_BORDER,12,238,86,10
    COMBOBOX        IDC_COMBO_BORDER,104,236,208,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    CONTROL         "Fill with tomorrow slots",IDC_CHK_FILL_TOMORROW,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,104,255,208,11

    LTEXT           "Refresh (min):",IDC_LBL_REFRESH,12,271,86,10
    EDITTEXT        IDC_EDIT_REFRESH,104,269,56,14,ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "",IDC_LBL_STATUS,168,271,144,10

    DEFPUSHBUTTON   "OK",IDOK,204,288,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,262,288,50,14
END